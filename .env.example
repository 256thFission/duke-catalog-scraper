# Duke Course Scraper Configuration
# Copy this file to .env and customize with your values
#
# IMPORTANT: Never commit your .env file to version control!
# It contains sensitive authentication information.

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Option 1: MFA Cookie (Recommended - easier and more reliable)
# ----------------------------------------------------------------------------
# Get this from your browser after logging in to DukeHub:
# 1. Log in to https://dukehub.duke.edu with "Remember me" checked
# 2. Open Developer Tools (F12) > Application/Storage > Cookies
# 3. Find shib.oit.duke.edu domain > copy the "mfa" cookie value
#
# Example (this is fake - use your real cookie):
# DUKE_MFA_COOKIE=c29tZV9sb25nX2Jhc2U2NF9lbmNvZGVkX3ZhbHVlX2hlcmU=
DUKE_NETID=
DUKE_PASSWORD=
DUKE_MFA_COOKIE=

# Option 2: Credentials (Alternative - triggers Duo push)
# ----------------------------------------------------------------------------
# Only needed if you want to use login_with_credentials() method
# This will trigger a Duo push notification each time you authenticate
#
# Example:
# DUKE_NETID=abc123
# DUKE_PASSWORD=your_secure_password_here

DUKE_NETID=
DUKE_PASSWORD=

# ============================================================================
# COURSE SEARCH SETTINGS
# ============================================================================

# Default Term Code
# ----------------------------------------------------------------------------
# Format: YCSS where:
#   Y  = Last digit of year (5 for 2025, 6 for 2026, etc.)
#   C  = Century digit (9 for 2000s)
#   SS = Semester (50=Spring, 60=Summer, 70=Fall)
#
# Common terms:
#   1950 = Spring 2025
#   1960 = Summer 2025
#   1970 = Fall 2025
#   1980 = Spring 2026

DEFAULT_TERM=1950

# Maximum Pages to Fetch
# ----------------------------------------------------------------------------
# Limit how many pages of results to fetch
# Leave empty for unlimited (fetch all available results)
# Set to a number like 5 or 10 for testing
#
# Examples:
#   MAX_PAGES=       (unlimited - fetch everything)
#   MAX_PAGES=5      (fetch only first 5 pages)

MAX_PAGES=

# Request Delay (seconds)
# ----------------------------------------------------------------------------
# Time to wait between API requests to avoid overwhelming the server
# Recommended: 0.5 to 1.0 seconds
# Lower values = faster but may trigger rate limiting
# Higher values = slower but more respectful of server resources

REQUEST_DELAY=0.5

# ============================================================================
# FILE LOCATIONS
# ============================================================================

# Session File
# ----------------------------------------------------------------------------
# Where to store authentication session data
# This file contains your active session cookies

SESSION_FILE=duke_session.pkl

# Output Directory
# ----------------------------------------------------------------------------
# Where to save scraped course data (JSON and CSV files)
# The directory will be created automatically if it doesn't exist

OUTPUT_DIR=data
