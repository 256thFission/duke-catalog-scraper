       role=\"button\"\r\n                               aria-label=\"View Report for Course COMPSCI-671D-10D - THEORY &amp; ALG MACHINE LEARNING.COMPSCI-671D-10D.ECE-687D-10D.STA-671D-10D.\">\r\n                                <i class=\"fa fa-eye\"></i> View Report\r\n                            </a>\r\n                        </p>\r\n                        <p class=\"small\" style=\"margin:0;padding-top:15px;\">\r\n                            <a href=\"#\"\r\n                               data-id0='98827'\r\n                               data-id1='t%2fFkKASUrBF6qRsNV5Za2w%3d%3d'\r\n                               data-id2='wTF4%2bubMu9%2brDQyTjuv4Ow%3d%3d'\r\n                               data-id3='wG%2fM66XfbOFNOV11Wj2bzA%3d%3d'\r\n                               class='sr-pdf btn btn-default btn-sm'\r\n                               role=\"button\"\r\n                               aria-label=\"Download PDF for Course COMPSCI-671D-10D - THEORY &amp; ALG MACHINE LEARNING.COMPSCI-671D-10D.ECE-687D-10D.STA-671D-10D.\">\r\n                                <i class=\"fa fa-download\"></i> Download PDF\r\n                            </a>\r\n                            <iframe class=\"ifPdfRes\" name=\"ifPdfRes\" width=\"0\" height=\"0\" src=\"\" style=\"display: none;\"></iframe>\r\n                        </p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n        <div style=\"padding:0 0 10px 15px;\">\r\n            <a id=\"questionsLink-154503_9169_12241663_27991703\" tabindex=\"0\" role=\"button\" aria-label=\"Questions for course COMPSCI-671D-10D - THEORY &amp; ALG MACHINE LEARNING.COMPSCI-671D-10D.ECE-687D-10D.STA-671D-10D.\" class=\"accordion-toggle collapsed getQuestions\" data-toggle=\"collapse\" aria-expanded=\"false\" aria-controls=\"sr-questions-154503_9169_12241663_27991703\" data-target=\"#sr-questions-154503_9169_12241663_27991703\" data-uid='154503_9169_12241663_27991703' style=\"width:100% !important;\">Questions</a>\r\n        </div>\r\n        <ul id=\"sr-questions-154503_9169_12241663_27991703\" class=\"collapse\" style=\"padding: 0; list-style-type: none;\" role=\"list\" aria-label=\"Questions for course COMPSCI-671D-10D - THEORY &amp; ALG MACHINE LEARNING.COMPSCI-671D-10D.ECE-687D-10D.STA-671D-10D.\"></ul>\r\n</li>\r\n\r\n\r\n<li class=\"sr-dataitem panel panel-default\" id=\"sr-154503_9169_12241668_27991773\">\r\n    <div class=\"panel-body\">\r\n        <div class=\"row\">\r\n            <div id=\"sr-desc-154503_9169_12241668_27991773\" class=\"col-sm-7 col-md-8 col-lg-9 sr-dataitem-info\">\r\n                    <p class=\"sr-dataitem-info-code\">\r\n                        COMPSCI-531D-001\r\n                    </p>\r\n                <h2 aria-label=\"COMPSCI-531D-001 - INTRODUCTION TO ALGORITHMS.COMPSCI-531D-001., Instructor Kamesh Munagala\">\r\n                    INTRODUCTION TO ALGORITHMS.COMPSCI-531D-001.\r\n                </h2>\r\n                    <p class=\"sr-dataitem-info-instr\">Munagala, Kamesh</p>\r\n                <p class=\"small\" style=\"margin-bottom:15px;\">Fall 2023<br />COMPSCI</p>\r\n            </div>\r\n            <div class=\"col-sm-5 col-md-4 col-lg-3 text-right sr-avg\">\r\n                <div style=\"display:inline-block\">\r\n                                                                                    <p class=\"small\" style=\"margin:0;padding-top:3px;\">\r\n                            <span>32 of 36  responded (88.89%)</span>\r\n                        </p>\r\n                                            <p class=\"small\" style=\"margin:0;padding-top:10px;\">\r\n                            <a href=\"#\"\r\n                               data-id0='98827'\r\n                               data-id1='t%2fFkKASUrBF6qRsNV5Za2w%3d%3d'\r\n                               data-id2='SX0KFKv24WKiL3aSg2sH0Q%3d%3d'\r\n                               data-id3='JtrnNZ83skNIVucxlQMVKA%3d%3d'\r\n                               class=\"sr-view-report btn btn-default btn-sm\"\r\n                               role=\"button\"\r\n                               aria-label=\"View Report for Course COMPSCI-531D-001 - INTRODUCTION TO ALGORITHMS.COMPSCI-531D-001.\">\r\n                                <i class=\"fa fa-eye\"></i> View Report\r\n                            </a>\r\n                        </p>\r\n                        <p class=\"small\" style=\"margin:0;padding-top:15px;\">\r\n                            <a href=\"#\"\r\n                               data-id0='98827'\r\n                               data-id1='t%2fFkKASUrBF6qRsNV5Za2w%3d%3d'\r\n                               data-id2='SX0KFKv24WKiL3aSg2sH0Q%3d%3d'\r\n                               data-id3='JtrnNZ83skNIVucxlQMVKA%3d%3d'\r\n                               class='sr-pdf btn btn-default btn-sm'\r\n                               role=\"button\"\r\n                               aria-label=\"Download PDF for Course COMPSCI-531D-001 - INTRODUCTION TO ALGORITHMS.COMPSCI-531D-001.\">\r\n                                <i class=\"fa fa-download\"></i> Download PDF\r\n                            </a>\r\n                            <iframe class=\"ifPdfRes\" name=\"ifPdfRes\" width=\"0\" height=\"0\" src=\"\" style=\"display: none;\"></iframe>\r\n                        </p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n        <div style=\"padding:0 0 10px 15px;\">\r\n            <a id=\"questionsLink-154503_9169_12241668_27991773\" tabindex=\"0\" role=\"button\" aria-label=\"Questions for course COMPSCI-531D-001 - INTRODUCTION TO ALGORITHMS.COMPSCI-531D-001.\" class=\"accordion-toggle collapsed getQuestions\" data-toggle=\"collapse\" aria-expanded=\"false\" aria-controls=\"sr-questions-154503_9169_12241668_27991773\" data-target=\"#sr-questions-154503_9169_12241668_27991773\" data-uid='154503_9169_12241668_27991773' style=\"width:100% !important;\">Questions</a>\r\n        </div>\r\n        <ul id=\"sr-questions-154503_9169_12241668_27991773\" class=\"collapse\" style=\"padding: 0; list-style-type: none;\" role=\"list\" aria-label=\"Questions for course COMPSCI-531D-001 - INTRODUCTION TO ALGORITHMS.COMPSCI-531D-001.\"></ul>\r\n</li>\r\n</ul>\r\n                        <a href=\"#more\" id=\"publicMore\" class='btn btn-default btn-block btn-lg'><span id=\"more-text\">Show more results</span><i id=\"more-spinner\" class=\"fa fa-refresh fa-spin fa-fw\" style=\"display:none;\"></i></a>\r\n        </div>\r\n    </div>\r\n</div>\r\n<!-- Modal -->\r\n<div class=\"modal fade\" id=\"modalScale\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"modalScaleLabel\">\r\n    <div class=\"modal-dialog\" role=\"document\">\r\n        <div class=\"modal-content\">\r\n            <div class=\"modal-header\">\r\n                <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\"><i aria-hidden=\"true\">&times;</i></button>\r\n                <h3 class=\"modal-title\" id=\"modalScaleLabel\">Question Response Scale</h3>\r\n            </div>\r\n            <div class=\"modal-body\">\r\n                <h4 id=\"modalScaleTitle\" style=\"margin-bottom:25px;\"></h4>\r\n                <div id=\"modalScaleBody\"></div>\r\n            </div>\r\n            <div class=\"modal-footer\">\r\n                <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Close</button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n<script src=\"/bundles/scripts/pages/publicReport?v=L_aQJLa0Ocetfl116HvuxJvAVD2Ye_6nJkY1HeSUm7g1\"></script>\r\n\r\n\r\n<style>\r\n    .sr-button-list {\r\n        display: flex;\r\n        gap: 15px;\r\n        justify-content: space-evenly;\r\n        flex-wrap: wrap;\r\n        width: 100%;\r\n    }\r\n\r\n    .sr-button {\r\n        flex-grow: 1;\r\n    }\r\n\r\n    .sr-filter {\r\n        display: inline-block;\r\n        padding: 6px 12px;\r\n        margin: 2px;\r\n        font-size: 14px;\r\n        font-weight: normal;\r\n        text-align: center;\r\n        background-color: #E9E7EC;\r\n        color: #4A4A4A;\r\n\r\n    }\r\n    .sr-filter i {\r\n        margin-left: 5px;\r\n        color:#575195;\r\n    }\r\n    .sr-disabled-filter {\r\n        display: inline-block;\r\n        padding: 6px 12px;\r\n        margin: 2px;\r\n        font-size: 14px;\r\n        font-weight: normal;\r\n        text-align: center;\r\n        background-color: #6B6B6B;\r\n        color: #FFFFFF;\r\n    }\r\n\r\n    .sr-disabled-filter i {\r\n        margin-left: 5px;\r\n    }\r\n\r\n\r\n\r\n</style>\r\n<script>\r\n    document.addEventListener('DOMContentLoaded', function () {\r\n        // Proper solution: Wait for web components to be fully defined and rendered\r\n        initializeDropdowns();\r\n\r\n        async function initializeDropdowns() {\r\n            try {\r\n                // Wait for custom elements to be defined\r\n                await Promise.all([\r\n                    customElements.whenDefined('wm-select'),\r\n                    customElements.whenDefined('wm-option')\r\n                ]);\r\n\r\n                // Wait for next frame to ensure components are rendered\r\n                await new Promise(resolve => requestAnimationFrame(resolve));\r\n\r\n                // Check each dropdown is properly hydrated before showing\r\n                const wmSelects = document.querySelectorAll('wm-select');\r\n                const initPromises = Array.from(wmSelects).map(select => waitForComponentReady(select));\r\n\r\n                await Promise.all(initPromises);\r\n\r\n                // All components are ready, show them\r\n                wmSelects.forEach(select => {\r\n                    select.classList.add('initialized');\r\n\r\n                    // Trim selected Area option text on load\r\n                    if (select.id === 'wmSelectArea') {\r\n                        trimSelectedAreaTextOnLoad(select);\r\n                    }\r\n                });\r\n\r\n            } catch (error) {\r\n                console.warn('Web component initialization failed, falling back to immediate show:', error);\r\n                // Fallback: show all components immediately\r\n                document.querySelectorAll('wm-select').forEach(select => {\r\n                    select.classList.add('initialized');\r\n                });\r\n            }\r\n        }\r\n\r\n        function waitForComponentReady(select) {\r\n            return new Promise((resolve) => {\r\n                // Check if component has shadow DOM and internal elements\r\n                function checkReady() {\r\n                    if (select.shadowRoot &&\r\n                        select.shadowRoot.querySelector('button') &&\r\n                        select.classList.contains('hydrated')) {\r\n                        resolve();\r\n                    } else {\r\n                        // Use MutationObserver to watch for changes\r\n                        const observer = new MutationObserver(() => {\r\n                            if (select.shadowRoot &&\r\n                                select.shadowRoot.querySelector('button') &&\r\n                                select.classList.contains('hydrated')) {\r\n                                observer.disconnect();\r\n                                resolve();\r\n                            }\r\n                        });\r\n\r\n                        observer.observe(select, {\r\n                            attributes: true,\r\n                            attributeFilter: ['class'],\r\n                            childList: true,\r\n                            subtree: true\r\n                        });\r\n\r\n                        // Timeout fallback after 3 seconds\r\n                        setTimeout(() => {\r\n                            observer.disconnect();\r\n                            resolve();\r\n                        }, 3000);\r\n                    }\r\n                }\r\n\r\n                checkReady();\r\n            });\r\n        }\r\n\r\n        function updateAreaButtonText(wmSelectArea, text) {\r\n            try {\r\n                const trimmedText = text.trim();\r\n\r\n                // Update the button text in the shadow DOM\r\n                const shadowRoot = wmSelectArea.shadowRoot;\r\n                if (shadowRoot) {\r\n                    const button = shadowRoot.querySelector('button');\r\n                    if (button) {\r\n                        const checkAndUpdateText = () => {\r\n                            const buttonTextSpan = button.querySelector('.button-text span');\r\n                            if (buttonTextSpan) {\r\n                                buttonTextSpan.textContent = trimmedText;\r\n                            } else {\r\n                                requestAnimationFrame(checkAndUpdateText);\r\n                            }\r\n                        };\r\n\r\n                        requestAnimationFrame(checkAndUpdateText);\r\n                    }\r\n                }\r\n            } catch (error) {\r\n                console.warn('Could not update Area dropdown button text:', error);\r\n            }\r\n        }\r\n\r\n        function trimSelectedAreaTextOnLoad(wmSelectArea) {\r\n            try {\r\n                // Find the currently selected option\r\n                const selectedOption = wmSelectArea.querySelector('wm-option[selected]');\r\n                if (selectedOption && selectedOption.textContent) {\r\n                    updateAreaButtonText(wmSelectArea, selectedOption.textContent);\r\n                }\r\n            } catch (error) {\r\n                console.warn('Could not trim Area dropdown text on load:', error);\r\n            }\r\n        }\r\n\r\n        // Setup wm-select event handlers for all dropdowns\r\n\r\n        // Term dropdown\r\n        const wmSelectTerm = document.getElementById('wmSelectTerm');\r\n        if (wmSelectTerm) {\r\n            wmSelectTerm.addEventListener('wmOptionSelected', function(event) {\r\n                const selectedValue = event.target ? event.target.value : '';\r\n\r\n                // Update hidden field for form submission\r\n                document.getElementById('hiddenTermId').value = selectedValue;\r\n\r\n                // Update all wm-option elements' selected state\r\n                const allOptions = wmSelectTerm.querySelectorAll('wm-option');\r\n                allOptions.forEach(option => {\r\n                    if (option.getAttribute('value') === selectedValue) {\r\n                        option.setAttribute('selected', 'true');\r\n                        option.setAttribute('aria-selected', 'true');\r\n                    } else {\r\n                        option.removeAttribute('selected');\r\n                        option.setAttribute('aria-selected', 'false');\r\n                    }\r\n                });\r\n            });\r\n        }\r\n\r\n        // Year dropdown\r\n        const wmSelectYear = document.getElementById('wmSelectYear');\r\n        if (wmSelectYear) {\r\n            wmSelectYear.addEventListener('wmOptionSelected', function(event) {\r\n                const selectedValue = event.target ? event.target.value : '';\r\n\r\n                // Update hidden field for form submission\r\n                document.getElementById('hiddenYear').value = selectedValue;\r\n\r\n                // Update all wm-option elements' selected state\r\n                const allOptions = wmSelectYear.querySelectorAll('wm-option');\r\n                allOptions.forEach(option => {\r\n                    if (option.getAttribute('value') === selectedValue) {\r\n                        option.setAttribute('selected', 'true');\r\n                        option.setAttribute('aria-selected', 'true');\r\n                    } else {\r\n                        option.removeAttribute('selected');\r\n                        option.setAttribute('aria-selected', 'false');\r\n                    }\r\n                });\r\n            });\r\n        }\r\n\r\n        // Area dropdown\r\n        const wmSelectArea = document.getElementById('wmSelectArea');\r\n        if (wmSelectArea) {\r\n            wmSelectArea.addEventListener('wmOptionSelected', function(event) {\r\n                const selectedValue = event.target ? event.target.value : '';\r\n\r\n                // Update hidden field for form submission\r\n                document.getElementById('hiddenAreaId').value = selectedValue;\r\n\r\n                // Update all wm-option elements' selected state\r\n                const allOptions = wmSelectArea.querySelectorAll('wm-option');\r\n                allOptions.forEach(option => {\r\n                    if (option.getAttribute('value') === selectedValue) {\r\n                        option.setAttribute('selected', 'true');\r\n                        option.setAttribute('aria-selected', 'true');\r\n                    } else {\r\n                        option.removeAttribute('selected');\r\n                        option.setAttribute('aria-selected', 'false');\r\n                    }\r\n                });\r\n\r\n                // Trim spaces from the displayed text in the button for hierarchy structure\r\n                if (event.target.textContent) {\r\n                    updateAreaButtonText(wmSelectArea, event.target.textContent);\r\n                }\r\n            });\r\n        }\r\n\r\n        // Question dropdown\r\n        const wmSelectQuestion = document.getElementById('wmSelectQuestion');\r\n        if (wmSelectQuestion) {\r\n            wmSelectQuestion.addEventListener('wmOptionSelected', function(event) {\r\n                const selectedValue = event.target ? event.target.value : '';\r\n\r\n                // Update hidden field for form submission\r\n                document.getElementById('hiddenQuestionKey').value = selectedValue;\r\n\r\n                // Update all wm-option elements' selected state\r\n                const allOptions = wmSelectQuestion.querySelectorAll('wm-option');\r\n                allOptions.forEach(option => {\r\n                    if (option.getAttribute('value') === selectedValue) {\r\n                        option.setAttribute('selected', 'true');\r\n                        option.setAttribute('aria-selected', 'true');\r\n                    } else {\r\n                        option.removeAttribute('selected');\r\n                        option.setAttribute('aria-selected', 'false');\r\n                    }\r\n                });\r\n\r\n                // Update visibility of view scale button based on QuestionKey selection\r\n                updateViewScaleButtonVisibility(selectedValue);\r\n            });\r\n        }\r\n\r\n        // Function to update view scale button visibility\r\n        function updateViewScaleButtonVisibility(questionKeyValue) {\r\n            const viewScaleButton = document.getElementById('viewQuestionResponseScale');\r\n\r\n\r\n            if (viewScaleButton) {\r\n                if (questionKeyValue && questionKeyValue.length > 0) {\r\n                    viewScaleButton.classList.remove('hidden');\r\n                } else {\r\n                    viewScaleButton.classList.add('hidden');\r\n                }\r\n            }\r\n        }\r\n\r\n        // Initialize view scale button visibility on page load\r\n        function initializeViewScaleButtonVisibility() {\r\n            const questionKeyValue = document.getElementById('hiddenQuestionKey').value;\r\n            updateViewScaleButtonVisibility(questionKeyValue);\r\n        }\r\n\r\n        // Call initialization after DOM is ready\r\n        initializeViewScaleButtonVisibility();\r\n    });\r\n</script>\r\n\r\n\r\n\r\n            </div>\r\n        </div>\r\n    </div>\r\n    \r\n\r\n<footer class=\"footer maincontentfooter\">\r\n  <div class=\"copyright\">\r\n    &copy; 2025 Watermark Insights, LLC and its affiliates. All rights reserved.\r\n  </div>\r\n  <div class=\"footernav\">\r\n    <ul class=\"nobullets\">\r\n      \r\n      <li><a class=\"footerlink\" href=\"/sitemap\">Sitemap</a></li>\r\n      \r\n      <li>\r\n        <a\r\n          class=\"footerlink\"\r\n          href=\"https://www.watermarkinsights.com/terms/\"\r\n          target=\"_blank\"\r\n          >Terms & Conditions</a\r\n        >\r\n      </li>\r\n      <li>\r\n        <a\r\n          class=\"footerlink\"\r\n          href=\"https://www.watermarkinsights.com/privacy-policy/\"\r\n          target=\"_blank\"\r\n          >Privacy Policy</a\r\n        >\r\n      </li>\r\n      <li>\r\n        <a\r\n          class=\"footerlink\"\r\n          href=\"https://www.watermarkinsights.com/accessibility/\"\r\n          target=\"_blank\"\r\n          >Accessibility Policy</a\r\n        >\r\n      </li>\r\n    </ul>\r\n  </div>\r\n</footer>\r\n\r\n\r\n\r\n    \r\n    \r\n\r\n<a id=\"backToTop\" href=\"#\" class=\"backToTop\" role=\"button\">Back to Top</a>\r\n\r\n<style>\r\n    .backToTop {\r\n        position: fixed;\r\n        bottom: 6rem; /* Default for tiny screens */\r\n        background-color: transparent;\r\n        text-decoration: none !important;\r\n        font-weight: 700;\r\n        display: inline-flex;\r\n        align-items: center;\r\n        gap: 5px;\r\n        left: 50%;\r\n        transform:translateX(-50%);\r\n        font-size: 12px;\r\n        font-style: normal;\r\n        font-weight: 700;\r\n        line-height: normal;\r\n        text-transform: uppercase;\r\n        padding: 10px 16px 10px 16px;\r\n        border-radius: 32px;    \r\n        border: 1px solid #575195;\r\n        background: #FFF;\r\n        /* shadow-styles/elevation-6 */\r\n        box-shadow: 0px 3px 5px 0px rgba(0, 0, 0, 0.20), 0px 1px 18px 0px rgba(0, 0, 0, 0.12), 0px 6px 10px 0px rgba(0, 0, 0, 0.14);\r\n        cursor: pointer;\r\n        z-index: 1049;      /* The Bootstrap modal z-index is 1050 and we want this component to display behind modals */\r\n    }\r\n\r\n    /* xs screens (414px and above) */\r\n    @media (min-width: 414px) {\r\n        .backToTop {\r\n            bottom: 4rem;\r\n        }\r\n    }\r\n\r\n    /* sm screens (768px and above) */\r\n    @media (min-width: 768px) {\r\n        .backToTop {\r\n            bottom: 4rem;\r\n        }\r\n    }\r\n\r\n    /* md screens and above (1024px and above) - back to original */\r\n    @media (min-width: 1024px) {\r\n        .backToTop {\r\n            bottom: 3rem;\r\n        }\r\n    }\r\n\r\n    .backToTop::before {\r\n        content: url(/Media/Icons/arrow_upward.svg);\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .backToTop:focus {\r\n        outline: 2px solid black;\r\n    }\r\n\r\n    .backToTop:hover {\r\n        text-decoration: underline !important;\r\n    }\r\n\r\n    /* Hide Back to Top button when any modal is open */\r\n    body.modal-open .backToTop,\r\n    .modal.show ~ .backToTop,\r\n    .modal.in ~ .backToTop {\r\n        display: none !important;\r\n    }\r\n\r\n</style>\r\n\r\n<script>\r\n    $(document).ready(function () {\r\n        const backToTopThreshhold = 300;\r\n\r\n        if ($('html').scrollTop() > backToTopThreshhold)\r\n            $(\"#backToTop\").show();\r\n        else\r\n            $(\"#backToTop\").hide();\r\n\r\n\r\n        $('#backToTop').click(function (e) {\r\n            $('html').animate({\r\n                scrollTop: 0\r\n            }, 500);\r\n            return false;\r\n        });\r\n\r\n        $(window).scroll(function () {\r\n            if ($(window).scrollTop() > backToTopThreshhold) {\r\n                $('#backToTop').show();\r\n            } else {\r\n                $('#backToTop').hide();\r\n            }\r\n        });\r\n\r\n        // Hide Back to Top button when modals are shown\r\n        $(document).on(\"shown.bs.modal\", function() {\r\n            $('#backToTop').hide();\r\n        });\r\n        \r\n        // Show Back to Top button when modals are hidden\r\n        $(document).on(\"hidden.bs.modal\", function() {\r\n            if ($(window).scrollTop() > backToTopThreshhold) {\r\n                $('#backToTop').show();\r\n            }\r\n        });\r\n    });\r\n</script>\r\n\r\n</body>\r\n</html>\r\n"
