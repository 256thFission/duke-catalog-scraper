bDateTime.getUTCDay() + ekTabDateTime.getUTCHours() + ekTabDateTime.getUTCMinutes() + ekTabDateTime.getUTCSeconds() + ekTabDateTime.getUTCMilliseconds();\r\n\r\n    //alert(window.name + ' --- ' + iPageTabID);\r\n</script>\r\n\r\n    <link href=\"/bundles/styles/respondent?v=ZH-HMtdqOut3bY_iJcqGB58Q37W4qBIEgdSEW-kyt7w1\" rel=\"stylesheet\"/>\r\n\r\n    <script src=\"/bundles/scripts/respondent?v=skndmngKlNeeEE91Jd5bJMkJKkLq4ajEYuYrr2ZFP9c1\"></script>\r\n\r\n    <link rel=\"preload\" href=\"/Content/font-files/inter/inter.css\" as=\"style\" onload=\"this.onload=null;this.rel='stylesheet'\">\r\n    <noscript><link rel=\"stylesheet\" href=\"/Content/font-files/inter/inter.css\"></noscript>\r\n    <script type=\"module\" src=\"https://cdn.watermarkinsights.com/ripple/5.17.0/ripple/ripple.js\"></script>\r\n    <script type=\"module\" src=\"../../Scripts/sessionMonitor.js\"></script>\r\n    \r\n        <style>\r\n            header {\r\n                background: #012169 !important;\r\n            }\r\n            .panel-body-survey-label,.surveynotsubmited {\r\n\r\n                border-left: 10px solid #FFFEFD !important;\r\n            }\r\n            .list-group-item:focus {\r\n              border-color: #FFFEFD;\r\n            }\r\n        </style>\r\n</head>\r\n<body>\r\n    <span id=\"calendarWidgetAlert\" hidden>\"Calendar opened; use CTRL+Arrow keys to navigate calendar\"</span>\r\n    <a class=\"skip-to\" role=\"button\" href=\"#containerwrapper\">Skip to main content</a>\r\n    \r\n    \r\n<header>\r\n    \r\n    <div class=\"container\">\r\n        <div class=\"row\">\r\n            <div class=\"col-sm-12\" style=\"min-height: 100px;\">\r\n                <img src=\"https://eval-duke.evaluationkit.com/Common/ShowLogo.aspx?id=VWRcNRs5gfuJYuYi8fccVA%3d%3d\" alt=\"Duke University - Course Evaluations\" class='logo' style='max-height:75px;max-width:100%'/>\r\n\r\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n\r\n\r\n            </div>\r\n        </div>\r\n    </div>\r\n</header>\r\n    \r\n<!-- navbar -->\r\n\r\n<!-- Modal TODO hide if not this option -->\r\n<div class=\"modal fade\" id=\"myModalSwitchAccount\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalSwitchAccountLabel\" aria-hidden=\"true\">\r\n    <div class=\"modal-dialog\">\r\n        <div class=\"modal-content\">\r\n            <div class=\"modal-header\">\r\n                <button type=\"button\" class=\"close\" data-dismiss=\"modal\"><i aria-hidden=\"true\">&times;</i><span class=\"sr-only\">Close</span></button>\r\n                <h4 class=\"modal-title\" id=\"myModalSwitchAccountLabel\"><b>Switch Account</b></h4>\r\n            </div>\r\n            <div class=\"modal-body\" id=\"modalBodyMain\">\r\n                <ul>\r\n                    \r\n                </ul>\r\n            </div>\r\n            <div class=\"modal-body\" id=\"modalBodySwitch\" style=\"display: none; text-align: center;\">\r\n            </div>\r\n            <div class=\"modal-footer\" id=\"modalFooter\">\r\n                <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Cancel</button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n<nav aria-label=\"Main Navigation\">\r\n    <div class=\"navbar navbar-default navbar-inverse\" id=\"siteNav\">\r\n        <div class=\"navbar-respondent\">\r\n            <div class=\"navbar-header\">\r\n                <button type=\"button\" class=\"navbar-toggle\" data-toggle=\"collapse\" data-target=\"#mainMenuArea\" aria-expanded=\"false\">\r\n                    <span class=\"sr-only\">Toggle navigation</span>\r\n                    <span class=\"icon-bar\"></span>\r\n                    <span class=\"icon-bar\"></span>\r\n                    <span class=\"icon-bar\"></span>\r\n                </button>\r\n            </div>\r\n            <div id=\"mainMenuArea\" class=\"navbar-collapse collapse\">\r\n                <ul class=\"nav yamm navbar-nav\">\r\n                    \r\n                    <li>\r\n                        <a href=\"https://eval-duke.evaluationkit.com/Respondent\">My Surveys</a>\r\n                    </li>\r\n                    \r\n                    <li>\r\n                        <a href=\"/Report/Public\" >Student Reporting</a>\r\n                    </li>\r\n                    \r\n                </ul>\r\n\r\n                \r\n<ul class=\"nav yamm navbar-nav navbar-right\" id=\"usernav\">\r\n\r\n\r\n\r\n\r\n <li class=\"dropdown\">\r\n        \r\n         <a href=\"#\" style=\"cursor: default;\">Student/Respondent</a>\r\n     \r\n    </li>\r\n\r\n\r\n    \r\n    <li class=\"dropdown\"><a href=\"#\" class=\"dropdown-toggle\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\" role=\"button\" >My Account <b class=\"caret\"></b></a>\r\n        <ul  class=\"dropdown-menu\">\r\n\r\n            \r\n            <li>\r\n                <a href=\"https://eval-duke.evaluationkit.com/MyEval/Signout.aspx?dir\" title=\"Sign Out\">Sign Out</a>\r\n            </li>\r\n            \r\n        </ul>\r\n    </li>\r\n\r\n\r\n\r\n\r\n\r\n        \r\n\r\n</ul>\r\n\r\n\r\n\r\n            </div>\r\n            <!--/.nav-collapse -->\r\n        </div>\r\n    </div>\r\n</nav>\r\n\r\n    \r\n    <div class=\"container\" id=\"containerwrapper\" role=\"main\" tabindex=\"-1\">\r\n        <div class=\"row\">\r\n            <div class=\"col-sm-12\">\r\n                \r\n\r\n<link href=\"/bundles/styles/respondent?v=ZH-HMtdqOut3bY_iJcqGB58Q37W4qBIEgdSEW-kyt7w1\" rel=\"stylesheet\"/>\r\n<link href=\"/bundles/styles/pages/publicReport?v=hBxsTpbRENURQYj19vZZVQ3TnURpHTLiVWF6QMgymh81\" rel=\"stylesheet\"/>\r\n\r\n<style>\r\n/* Hide dropdowns until they're properly initialized */\r\nwm-select:not(.initialized) {\r\n    opacity: 0;\r\n}\r\nwm-select.initialized {\r\n    opacity: 1;\r\n    transition: opacity 0.3s ease-in-out;\r\n}\r\n\r\n/* Custom dropdown option states */\r\nwm-option {\r\n    --hover-bg: #F4F4F4;\r\n    --selected-bg: #EEEDF7;\r\n    --focused-bg: #716CB0;\r\n    }\r\n\r\n/* Hover state for dropdown options */\r\nwm-option:hover {\r\n    background-color: var(--hover-bg) !important;\r\n}\r\n\r\n/* Selected state with check mark */\r\nwm-option[aria-selected=\"true\"] {\r\n    background-color: var(--selected-bg) !important;\r\n    position: relative;\r\n    padding-left: 32px !important;\r\n    font-weight: bold;\r\n}\r\n\r\nwm-option[aria-selected=\"true\"]::before {\r\n    content: '\\2713';\r\n    position: absolute;\r\n    left: 12px;\r\n    top: 50%;\r\n    transform: translateY(-50%);\r\n    color: #4A4A4A;\r\n    font-size: 14px;\r\n}\r\n\r\n/* Focus state for dropdown options */\r\nwm-option:focus,\r\nwm-option[tabindex=\"0\"] {\r\n    background-color: var(--focused-bg) !important;\r\n    color: white !important;\r\n}\r\n\r\n/* When selected option is focused, change checkmark color to white */\r\nwm-option[aria-selected=\"true\"]:focus::before,\r\nwm-option[aria-selected=\"true\"][tabindex=\"0\"]::before {\r\n    color: white !important;\r\n}\r\n\r\n/* Ensure the internal option wrapper inherits the styling */\r\nwm-option:hover .option-wrapper,\r\nwm-option[aria-selected=\"true\"] .option-wrapper,\r\nwm-option:focus .option-wrapper {\r\n    background-color: inherit;\r\n    color: inherit;\r\n}\r\n\r\n.requiredFieldInstructions{\r\n    text-align: center;\r\n    margin-bottom: 20px;\r\n}\r\n.search-fields {\r\n    margin-bottom: 12px;\r\n}\r\n.main-search-label {\r\n    display: block;\r\n    font-weight: 600;\r\n    color: #4A4A4A;\r\n    font-size: 18px;\r\n    text-align: left;\r\n    width: 100%;\r\n}\r\n\r\n.main-search-label.error {\r\n    color: #C0392B;\r\n}\r\n.required-asterisk {\r\n    color: #d9534f;\r\n    font-weight: bold;\r\n}\r\n\r\n.inline-validation-message {\r\n    margin-bottom: 16px;\r\n    color: #C0392B;\r\n    font-size: 14px;\r\n    display: flex;\r\n}\r\n\r\n.validation-text {\r\n    font-style: italic;\r\n}\r\n\r\n.sr-only {\r\n    position: absolute;\r\n    width: 1px;\r\n    height: 1px;\r\n    padding: 0;\r\n    margin: -1px;\r\n    overflow: hidden;\r\n    clip: rect(0, 0, 0, 0);\r\n    white-space: nowrap;\r\n    border: 0;\r\n}\r\n\r\n.validation-icon {\r\n    color: #C0392B;\r\n    font-size: 16px;\r\n}\r\n.filter-results-label{\r\n    padding-top: 10px;\r\n    display: block;\r\n    font-weight: 600;\r\n    color: #4A4A4A;\r\n    font-size: 18px;\r\n    text-align: left;\r\n    width: 100%;\r\n}\r\n</style>\r\n<div class=\"sr-results\">\r\n    <div class=\"sr-page-header\">\r\n        <h1>Student Accessible Course Evaluation System (SACES)</h1>\r\n    </div>\r\n    <div class=\"row\">\r\n        <div class=\"col-sm-4 col-md-4 col-lg-3\">\r\n            <div id=\"srnav\" data-spy=\"affix\" data-offset-top=\"600\" class=\"sr-affix-respondent\">\r\n<form DefaultButton=\"srsearchsubmit\" action=\"/Report/Public/Results\" id=\"sr-search-form\" method=\"get\">                    <div class=\"sr-results-navbar\">\r\n                        <div class=\"requiredFieldInstructions\">\r\n                            \r\n\r\n<span id=\"reqFieldsInstructions\" class=\"requiredFieldsText\">Fields marked with&nbsp;<span class=\"validation\">*</span> are required.</span>\r\n\r\n<style>\r\n    .requiredFieldsText {\r\n        display: block;\r\n        font-size: 14px;\r\n        color: #4a4a4a;\r\n    }\r\n</style>\r\n\r\n                        </div>\r\n                        <div class=\"search-fields\">\r\n                        <div class=\"main-search-label\">Search by Course or Instructor <span class=\"required-asterisk\">*</span> <i class=\"fa fa-exclamation-triangle validation-icon\" id=\"mainValidationIcon\" style=\"display: none;\" aria-hidden=\"true\"></i></div>\r\n                        <div class=\"inline-validation-message\" id=\"searchValidationMessage\" style=\"display: none;\" role=\"alert\" aria-live=\"polite\" aria-atomic=\"true\">\r\n                        <span class=\"validation-text\">Please enter a search term (at least 2 characters) before searching.</span>\r\n                        </div>\r\n                        <div id=\"validation-live-region\" aria-live=\"polite\" aria-atomic=\"true\" class=\"sr-only\"></div>\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                            <label class=\"form-label\" for=\"Course\"><span>Course Code or Course Title</span></label>\r\n                            <input class=\"form-control\" data-val=\"true\" data-val-length=\"Please limit your course search to 500 chars or less.\" data-val-length-max=\"500\" id=\"Course\" maxlength=\"500\" name=\"Course\" placeholder=\"Enter course code or title\" type=\"text\" value=\"compsci\" />\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                            <label class=\"form-label\" for=\"Instructor\"><span>Instructor Name</span></label>\r\n                            <input class=\"form-control\" data-val=\"true\" data-val-length=\"Please limit your instructor search to 500 chars or less.\" data-val-length-max=\"500\" id=\"Instructor\" maxlength=\"500\" name=\"Instructor\" placeholder=\"Enter instructor name\" type=\"text\" value=\"\" />\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                           <div class=\"filter-results-label\">Filter Results</div>\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                            <wm-select id=\"wmSelectTerm\" label=\"Term\" search=\"true\" search-placeholder=\"Search for a term\">\r\n                                <wm-option value=\"\" selected>All Terms</wm-option>\r\n                                        <wm-option value=\"9169\" >Fall 2023</wm-option>\r\n                                        <wm-option value=\"9973\" >Fall 2024</wm-option>\r\n                                        <wm-option value=\"8853\" >Spring 2023</wm-option>\r\n                                        <wm-option value=\"9470\" >Spring 2024</wm-option>\r\n                                        <wm-option value=\"10319\" >Spring 2025</wm-option>\r\n                                        <wm-option value=\"8928\" >Summer I 2023</wm-option>\r\n                                        <wm-option value=\"9753\" >Summer I 2024</wm-option>\r\n                                        <wm-option value=\"10662\" >Summer I 2025</wm-option>\r\n                                        <wm-option value=\"9107\" >Summer II 2023</wm-option>\r\n                                        <wm-option value=\"9917\" >Summer II 2024</wm-option>\r\n                            </wm-select>\r\n                            <input type=\"hidden\" name=\"TermId\" id=\"hiddenTermId\" />\r\n                        </div>\r\n                            <div class=\"form-group\">\r\n                                <wm-select id=\"wmSelectYear\" label=\"Year\" search=\"true\" search-placeholder=\"Search for a year\">\r\n                                    <wm-option value=\"\" selected>All Years</wm-option>\r\n                                            <wm-option value=\"2023\" >2023</wm-option>\r\n                                            <wm-option value=\"2024\" >2024</wm-option>\r\n                                            <wm-option value=\"2025\" >2025</wm-option>\r\n                                </wm-select>\r\n                                <input type=\"hidden\" name=\"Year\" id=\"hiddenYear\" />\r\n                            </div>\r\n                        <div class=\"form-group\">\r\n                            <wm-select id=\"wmSelectArea\" label=\"Area\" search=\"true\" search-placeholder=\"Search for an area\">\r\n                                <wm-option value=\"\" >All Areas</wm-option>\r\n                                        <wm-option value=\"98278\" >DUKEU</wm-option>\r\n                                        <wm-option value=\"98791\" >&#160;&#160;&#160;&#160;&#160;ALHC</wm-option>\r\n                                        <wm-option value=\"98792\" >&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;AHCC</wm-option>\r\n                                        <wm-option value=\"98793\" >&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;MEDICINE</wm-option>\r\n                                        <wm-option value=\"98794\" >&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;OPHTHAL</wm-option>\r\n                                        <wm-option value=\"98795\" >&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;POPHLTHSCI</wm-option>\r\n                                        <wm-option value=\"98796\" >&#160;&#160;&#160;&#160;&#160;ALHG</wm-option>\r\n                                        <wm-option value=\"98797\" >&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;AHCG</wm-option>\r\n                                        <wm-option value=\"98798\" >&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;AHCG</wm-option>\r\n                                        <wm-option value=\"98799\" >&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;BIOSTATINF</wm-option>\r\n                                        <wm-option value=\"98800\" >&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;COM/FAMMD</wm-option>\r\n                                        <wm-option value=\"98801\" >&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;DUKEU</wm-option>\r\n                                        <wm-option value=\"108684\" >&#160;&#160;&#160;&#160;&#160;DI</wm-option>\r\n                                        <wm-option value=\"98338\" >&#160;&#160;&#160;&#160;&#1